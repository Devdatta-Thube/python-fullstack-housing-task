# -----------------------------------------------------------------------------
# Example environment configuration for the Housing Price stack.
#
# Copy this file to `.env` in the repository root if you want to override any
# defaults. All variables have working defaults, so `.env` is optional.
#
# This file contains NO SECRETS — there is nothing sensitive to protect.
# -----------------------------------------------------------------------------

# ---- ml-api (port 8000) -----------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8000

# ---- estimator-api (port 8001) ---------------------------------------------
ML_API_URL=http://ml-api:8000
HISTORY_DB_PATH=/app/data/history.db

# ---- market-api (port 8002) ------------------------------------------------
# ML_API_URL is shared with estimator-api, no need to repeat.
DATASET_PATH=/app/data/housing.csv
AGGREGATE_CACHE_TTL=300
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=market-api,localhost,127.0.0.1
# Set this to a long random string in any deployment where Django sessions matter.
# DJANGO_SECRET_KEY=replace-me

# ---- frontend / portal (port 3000) -----------------------------------------
# Rendered into the browser bundle at build time — must be reachable from the
# user's browser, not from inside Docker.
NEXT_PUBLIC_ESTIMATOR_API_URL=http://localhost:8001
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8002
